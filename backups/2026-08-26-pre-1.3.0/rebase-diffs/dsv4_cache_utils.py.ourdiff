--- dsv4_cache_utils.py.122	2026-08-26 20:12:25.101272103 +0200
+++ /home/mp/Projekte/v100-skinny/fork_patches/dsv4_cache_utils.py	2026-08-25 20:34:59.895439899 +0200
@@ -17,6 +17,17 @@
 import torch
 
 from vllm.triton_utils import tl, triton
+
+# fork: pre-SM89 devices have no fp8e4nv in Triton (verified on sm70 AND
+# sm75: "type fp8e4nv not supported in this architecture. The supported
+# fp8 dtypes are ('fp8e4b15', 'fp8e5')"). vLLM already ships the capability
+# gate for its turboquant path -- reuse it rather than duplicating it.
+from vllm.v1.attention.ops.triton_turboquant_decode import _use_fp8_e4b15
+
+
+def _e4b15_flag(t: torch.Tensor) -> int:
+    idx = t.device.index
+    return _use_fp8_e4b15(torch.cuda.current_device() if idx is None else idx)
 from vllm.utils.import_utils import has_cutedsl
 
 
@@ -39,6 +50,7 @@
     block_stride: tl.constexpr,  # total bytes per block (padded)
     fp8_max: tl.constexpr,
     n_quant_blocks: tl.constexpr,  # 8 (7 real + 1 padding)
+    FP8_E4B15: tl.constexpr,  # fork: pre-SM89 fp8 substitute
 ):
     """
     Quantize K tensor and insert into paged K cache.
@@ -112,8 +124,15 @@
             x_scaled = x / scale
             x_clamped = tl.clamp(x_scaled, -fp8_max, fp8_max)
 
-            # Convert to fp8, then bitcast to uint8 for storage
-            x_fp8 = x_clamped.to(tl.float8e4nv)
+            # Convert to fp8, then bitcast to uint8 for storage.
+            # fork: e4b15 shares e4m3fn's 1-4-3 layout and differs only in
+            # exponent bias (15 vs 7), so scaling by 2**-8 first yields
+            # byte-identical output -- exact for all 254 finite e4m3fn
+            # values (scripts/triton_fp8_e4b15_test.py).
+            if FP8_E4B15:
+                x_fp8 = (x_clamped * (1.0 / 256.0)).to(tl.float8e4b15)
+            else:
+                x_fp8 = x_clamped.to(tl.float8e4nv)
             x_uint8 = x_fp8.to(tl.uint8, bitcast=True)
 
             # Store as uint8 (1 byte each)
@@ -191,6 +210,7 @@
         block_stride=block_stride,
         fp8_max=FP8_MAX,
         n_quant_blocks=8,
+        FP8_E4B15=_e4b15_flag(k_cache),
     )
 
 
@@ -216,6 +236,7 @@
     output_dim: tl.constexpr,  # 512
     fp8_max: tl.constexpr,
     n_quant_blocks: tl.constexpr,  # 7 real blocks
+    FP8_E4B15: tl.constexpr,  # fork: pre-SM89 fp8 substitute
 ):
     batch_idx = tl.program_id(0)
     worker_id = tl.program_id(1)
@@ -273,11 +294,16 @@
                 # Load quantized fp8 values (stored as uint8)
                 x_uint8 = tl.load(token_fp8_ptr + offsets, mask=mask, other=0)
 
-                # Bitcast uint8 back to fp8
-                x_fp8 = x_uint8.to(tl.float8e4nv, bitcast=True)
-
-                # Convert fp8 to float32 for computation
-                x_float = x_fp8.to(tl.float32)
+                # Bitcast uint8 back to fp8, then to float32.
+                # fork: the e4b15 decode is exact after a factor 2**8;
+                # only the e4m3fn NaN codes 0x7F/0xFF differ, and the UE8M0
+                # quantizer never emits them (it clamps at 448 = 0x7E).
+                if FP8_E4B15:
+                    x_float = (
+                        x_uint8.to(tl.float8e4b15, bitcast=True).to(tl.float32) * 256.0
+                    )
+                else:
+                    x_float = x_uint8.to(tl.float8e4nv, bitcast=True).to(tl.float32)
 
                 # Load and decode UE8M0 scale
                 # UE8M0: scale = 2^(stored_value - 127)
@@ -347,6 +373,7 @@
         output_dim=512,
         fp8_max=FP8_MAX,
         n_quant_blocks=7,
+        FP8_E4B15=_e4b15_flag(k_cache),
     )
 
 
