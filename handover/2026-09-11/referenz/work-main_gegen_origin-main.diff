+        changing = [(p, st) for p, st in stats.items() if st[1] > 0]
+        changing.sort(key=lambda x: -x[1][1])
+        print(f"[e5-diff] rounds_diffed={n_diffed} fields={len(stats)} "
+              f"byte_identical={len(always_same)} "
